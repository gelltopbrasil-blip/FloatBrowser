{
  "manifest_version": 2,
  "name": "FloatProxy",
  "version": "1.1",
  "browser_specific_settings": { "gecko": { "id": "floatproxy@floatbrowser.app" } },
  "background": { "scripts": ["bg.js"] },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["tools.js"], "run_at": "document_idle", "all_frames": false }
  ],
  "permissions": ["proxy", "webRequest", "webRequestBlocking", "nativeMessaging", "geckoViewAddons", "storage", "<all_urls>"]
}
