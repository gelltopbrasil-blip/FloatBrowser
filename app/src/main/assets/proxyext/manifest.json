{
  "manifest_version": 2,
  "name": "FloatProxy",
  "version": "1.0",
  "browser_specific_settings": { "gecko": { "id": "floatproxy@floatbrowser.app" } },
  "background": { "scripts": ["bg.js"] },
  "permissions": ["proxy", "webRequest", "webRequestBlocking", "nativeMessaging", "geckoViewAddons", "<all_urls>"]
}
